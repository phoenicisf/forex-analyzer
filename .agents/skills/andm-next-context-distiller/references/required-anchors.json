{
  "source_workflow": ".agents/workflows/next.md",
  "mandatory_headings": [
    "Phase 0: Onboarding",
    "Pre-check 0: Unresolved Breakage Override",
    "Check 0: Open Backtracks",
    "Check 0.5: Open Amendment Obligations",
    "Check 0.7: Backtrack/Overview Reconciliation",
    "Check 1: BA Deliverables",
    "Check 2: System Design Deliverables",
    "Check 3: Design QA - BA Review",
    "Check 4: Design QA - SD Review",
    "Check 4.5: UX/UI Design Deliverables",
    "Check 4.7: Technical Design Deliverables",
    "Check 4.8: Design QA - TD Review",
    "Check 4.9: Project Bootstrap",
    "Check 5: Implementation Plan",
    "Check 5.25: Implementation Plan QA",
    "Check 5.5: State Reconciliation",
    "Check 5.7: Operator Action Registry",
    "Check 5.8: Plan Staleness Sentinel",
    "Check 6: Implementation Tasks",
    "Check 6Q: QA Plan Deliverables",
    "Check 7: Code Review",
    "Check 7Q: QA Review / Rebuttal",
    "Check 8: Red Team Security Audit",
    "Check 9: Delivery Handoff",
    "Check 10: All Done",
    "Phase 1.9: Navigation Decision Layer",
    "Phase 2: Report to User"
  ],
  "mandatory_commands": [
    "/ba",
    "/ba-review all",
    "/ba-rebuttal",
    "/sd",
    "/sd-review all",
    "/sd-rebuttal",
    "/ux-design",
    "/ux-review",
    "/td",
    "/td-review all",
    "/td-rebuttal",
    "/project-init",
    "/project-init --regen",
    "/impl-plan 1",
    "/impl-plan-review all",
    "/impl-plan-rebuttal",
    "/impl-task",
    "/impl-review all",
    "/impl-review-fix",
    "/qa-review all",
    "/qa-rebuttal",
    "/red-team all",
    "/red-team-rebuttal",
    "/deliver all"
  ],
  "required_phrases": [
    "BREAKAGE OVERRIDE",
    "STOP",
    "Do first:",
    "Do NOT do yet:",
    "Confidence:",
    "Files to open before starting:"
  ],
  "drop_heading_patterns": [
    "^### 1\\.9\\.5: Self-Validation Scenario Matrix"
  ],
  "drop_line_patterns": [
    "review-from-gpt",
    "^> \\*\\*Why this",
    "^\\*\\*Living document:\\*\\*",
    "^\\*\\*Test protocol:\\*\\*"
  ],
  "keep_line_patterns": [
    "^\\d+\\. ",
    "^- ",
    "^\\|",
    "^```",
    "^Phase:",
    "^Status:",
    "^Next Action:",
    "^Check:",
    "^Read:",
    "^If ",
    "^Once read",
    "STOP",
    "/[a-z][a-z0-9-]*"
  ],
  "thresholds": {
    "min_heading_coverage": 0.95,
    "min_command_coverage": 0.95,
    "min_phrase_coverage": 1.0,
    "max_compression_ratio": 0.6,
    "max_dropped_runtime_heading_misses": 1,
    "max_banned_marker_hits": 0
  }
}
